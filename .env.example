# ---------------------------------------------------------------------------
# neo-mem — configuration template
# Copy this file to .env and fill in your values. NEVER commit your .env.
# ---------------------------------------------------------------------------

# --- Neo4j connection -------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASS=change-me
NEO4J_DATABASE=neo4j

# --- Embedding provider -----------------------------------------------------
# ollama = local embeddings (free, uses your own GPU).  DEFAULT.
# openai = OpenAI or any OpenAI-compatible API (OpenRouter, Azure, etc.)
EMBEDDING_PROVIDER=ollama

# For ollama (local):
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama

# For openai / openrouter, switch to:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-...

# --- Vector index settings --------------------------------------------------
NEO4J_EMBEDDING_DIMENSION=768
NEO4J_SIMILARITY_THRESHOLD=0.75
